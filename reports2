/* ---------------------------------------------------------
   RENDER CALIB TABLE
--------------------------------------------------------- */
function renderCALIB(){
  const search = document.getElementById("globalSearch").value.toLowerCase();
  const party = document.getElementById("calib_filter_party").value;
  const lot = document.getElementById("calib_filter_lot").value;
  const dateFrom = document.getElementById("calib_filter_date_from").value;
  const dateTo = document.getElementById("calib_filter_date_to").value;

  let filtered = CALIB_PARENTS.filter(p => {
    if (party && p.party !== party) return false;
    if (lot && p.lotName !== lot) return false;
    if (dateFrom && p.date < dateFrom) return false;
    if (dateTo && p.date > dateTo) return false;
    if (search) {
      const txt = JSON.stringify(p).toLowerCase();
      if (!txt.includes(search)) return false;
    }
    return true;
  });

  const tbody = document.getElementById("tbody_calib");
  tbody.innerHTML = "";

  let totalCTS = 0, totalAmt = 0;
  let soldCTS = 0, soldAmt = 0;
  let balCTS = 0, balAmt = 0;

  filtered.forEach(parent => {
    const sells = CALIB_SELLS.filter(s => s.parentKey === parent.key);

    const soldC = sells.reduce((sum, s) => sum + s.cts, 0);
    const soldA = sells.reduce((sum, s) => sum + s.amount, 0);

    const origCTS = parent.cts;

    const totalC = origCTS + soldC;
    const totalA = parent.amount + soldA;

    const balC = origCTS;
    const balA = parent.amount;

    const avgSellPrice = soldC > 0 ? soldA / soldC : 0;

    totalCTS += totalC;
    totalAmt += totalA;

    soldCTS += soldC;
    soldAmt += soldA;

    balCTS += balC;
    balAmt += balA;

    const row = `
      <tr>
        <td>${esc(parent.txId)}</td>
        <td>${esc(parent.date)}</td>
        <td>${esc(parent.party)}</td>
        <td>${esc(parent.lotName || '')}</td>
        <td>${esc(parent.grade || '')}</td>
        <td>${esc(parent.description || '')}</td>

        <td class="num-cell section-col total-col">${fmt(totalC)}</td>
        <td class="num-cell total-col">${fmt(parent.price)}</td>
        <td class="num-cell total-col">${fmt(totalA)}</td>

        <td class="num-cell section-col sold-col">${fmt(soldC)}</td>
        <td class="num-cell sold-col">${fmt(avgSellPrice)}</td>
        <td class="num-cell sold-col">${fmt(soldA)}</td>

        <td class="num-cell section-col balance-col">${fmt(balC)}</td>
        <td class="num-cell balance-col">${fmt(parent.price)}</td>
        <td class="num-cell balance-col">${fmt(balA)}</td>
      </tr>
    `;
    tbody.insertAdjacentHTML("beforeend", row);
  });

  /* UPDATE HEADER TOTALS */
  document.getElementById("calib_total_cts").textContent = fmt(totalCTS);
  document.getElementById("calib_total_amt").textContent = fmt(totalAmt);

  document.getElementById("calib_sold_cts").textContent = fmt(soldCTS);
  document.getElementById("calib_sold_amt").textContent = fmt(soldAmt);

  document.getElementById("calib_bal_cts").textContent = fmt(balCTS);
  document.getElementById("calib_bal_amt").textContent = fmt(balAmt);
}

/* ---------------------------------------------------------
   EXPORT TABLE TO CSV
--------------------------------------------------------- */
function exportToCSV(type){
  const table = type === 'AJMZ'
    ? document.querySelector('#tabAJMZ .ledger-table')
    : document.querySelector('#tabCALIB .ledger-table');

  let csv = [];
  const rows = table.querySelectorAll('tr');

  for (let row of rows) {
    let cols = row.querySelectorAll('td, th');
    let csvRow = [];
    for (let col of cols) {
      let text = col.textContent.replace(/"/g, '""');
      csvRow.push('"' + text + '"');
    }
    csv.push(csvRow.join(','));
  }

  const blob = new Blob([csv.join("\n")], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `${type}_Ledger_${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
}

/* ---------------------------------------------------------
   DOM EVENTS
--------------------------------------------------------- */
document.addEventListener("DOMContentLoaded", async () => {
  await loadData();

  /* TAB SWITCHING */
  document.querySelectorAll(".tab-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      const target = btn.dataset.tab;
      document.querySelectorAll(".tab-section").forEach(sec =>
        sec.classList.remove("active")
      );
      document.getElementById(target).classList.add("active");
    });
  });

  /* GLOBAL SEARCH */
  document.getElementById("globalSearch").addEventListener("input", () => {
    renderAJMZ();
    renderCALIB();
  });

  /* AJMZ FILTERS */
  document.getElementById("ajmz_filter_party").addEventListener("change", renderAJMZ);
  document.getElementById("ajmz_filter_lot").addEventListener("change", renderAJMZ);
  document.getElementById("ajmz_filter_date_from").addEventListener("change", renderAJMZ);
  document.getElementById("ajmz_filter_date_to").addEventListener("change", renderAJMZ);

  document.getElementById("ajmz_clear").addEventListener("click", () => {
    document.getElementById("ajmz_filter_party").value = "";
    document.getElementById("ajmz_filter_lot").value = "";
    document.getElementById("ajmz_filter_date_from").value = "";
    document.getElementById("ajmz_filter_date_to").value = "";
    document.getElementById("globalSearch").value = "";
    renderAJMZ();
  });

  document.getElementById("ajmz_export").addEventListener("click", () => 
    exportToCSV("AJMZ")
  );

  /* CALIB FILTERS */
  document.getElementById("calib_filter_party").addEventListener("change", renderCALIB);
  document.getElementById("calib_filter_lot").addEventListener("change", renderCALIB);
  document.getElementById("calib_filter_date_from").addEventListener("change", renderCALIB);
  document.getElementById("calib_filter_date_to").addEventListener("change", renderCALIB);

  document.getElementById("calib_clear").addEventListener("click", () => {
    document.getElementById("calib_filter_party").value = "";
    document.getElementById("calib_filter_lot").value = "";
    document.getElementById("calib_filter_date_from").value = "";
    document.getElementById("calib_filter_date_to").value = "";
    document.getElementById("globalSearch").value = "";
    renderCALIB();
  });

  document.getElementById("calib_export").addEventListener("click", () => 
    exportToCSV("CALIB")
  );
});
</script>

