<script>
/* ---------------------------------------------------------
   FIREBASE CONFIG + INIT
--------------------------------------------------------- */
const firebaseConfig = {
  apiKey:"AIzaSyC72tFu_MdXf4eq4PMI-rtd4PpMfpLNZpM",
  authDomain:"ajmzinventory.firebaseapp.com",
  databaseURL:"https://ajmzinventory-default-rtdb.asia-southeast1.firebasedatabase.app",
  projectId:"ajmzinventory",
  storageBucket:"ajmzinventory.firebasestorage.app",
  messagingSenderId:"1069845316242",
  appId:"1:1069845316242:web:c55be9de3724734f88dc4b"
};
firebase.initializeApp(firebaseConfig);
const db = firebase.database();

/* ---------------------------------------------------------
   DATA STORAGE ARRAYS
--------------------------------------------------------- */
let AJMZ_PARENTS = [];
let CALIB_PARENTS = [];
let AJMZ_SELLS = [];
let CALIB_SELLS = [];

/* ---------------------------------------------------------
   HELPERS
--------------------------------------------------------- */
function esc(s){
  return s == null ? "" : String(s)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;");
}
function fmt(n){
  return Number(n || 0).toLocaleString("en-US", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  });
}
function parseNum(v){
  return Number(String(v || "0").replace(/,/g,"")) || 0;
}

/* ---------------------------------------------------------
   LOAD DATA FROM FIREBASE
--------------------------------------------------------- */
async function loadData(){
  const [ajParents, calibParents, ajSells, calibSells] = await Promise.all([
    db.ref("ajmzRecords").once("value"),
    db.ref("calibRecords").once("value"),
    db.ref("sellRecords/ajmz").once("value"),
    db.ref("sellRecords/calib").once("value")
  ]);

  AJMZ_PARENTS = [];
  CALIB_PARENTS = [];
  AJMZ_SELLS = [];
  CALIB_SELLS = [];

  /* --------------------------
     AJMZ Parent Records
  -------------------------- */
  if (ajParents.exists()) {
    ajParents.forEach(snap => {
      const v = snap.val();
      v.key = snap.key;
      v.cts = parseNum(v.cts);
      v.pcs = parseNum(v.pcs);
      v.price = parseNum(v.price);
      v.amount = parseNum(v.amount || (v.cts * v.price));
      AJMZ_PARENTS.push(v);
    });
  }

  /* --------------------------
     CALIB Parent Records
  -------------------------- */
  if (calibParents.exists()) {
    calibParents.forEach(snap => {
      const v = snap.val();
      v.key = snap.key;
      v.cts = parseNum(v.cts);
      v.price = parseNum(v.price);
      v.amount = parseNum(v.amount || (v.cts * v.price));
      CALIB_PARENTS.push(v);
    });
  }

  /* --------------------------
     AJMZ Sell Records
  -------------------------- */
  if (ajSells.exists()) {
    ajSells.forEach(snap => {
      const r = snap.val();
      r.key = snap.key;
      r.cts = parseNum(r.cts);
      r.pcs = parseNum(r.pcs);
      r.sellPrice = parseNum(r.sellPrice || r.price);
      r.amount = parseNum(r.amount || r.cts * r.sellPrice);
      AJMZ_SELLS.push(r);
    });
  }

  /* --------------------------
     CALIB Sell Records
  -------------------------- */
  if (calibSells.exists()) {
    calibSells.forEach(snap => {
      const r = snap.val();
      r.key = snap.key;
      r.cts = parseNum(r.cts);
      r.sellPrice = parseNum(r.sellPrice || r.price);
      r.amount = parseNum(r.amount || r.cts * r.sellPrice);
      CALIB_SELLS.push(r);
    });
  }

  populateFilters();
  renderAJMZ();
  renderCALIB();
}

/* ---------------------------------------------------------
   POPULATE FILTERS
--------------------------------------------------------- */
function populateFilters(){
  const ajParties = [...new Set(AJMZ_PARENTS.map(p => p.party).filter(Boolean))].sort();
  const ajLots = [...new Set(AJMZ_PARENTS.map(p => p.lotName).filter(Boolean))].sort();

  const calibParties = [...new Set(CALIB_PARENTS.map(p => p.party).filter(Boolean))].sort();
  const calibLots = [...new Set(CALIB_PARENTS.map(p => p.lotName).filter(Boolean))].sort();

  /* AJMZ */
  document.getElementById("ajmz_filter_party").innerHTML =
    '<option value="">All</option>' +
    ajParties.map(p => `<option value="${esc(p)}">${esc(p)}</option>`).join('');

  document.getElementById("ajmz_filter_lot").innerHTML =
    '<option value="">All</option>' +
    ajLots.map(l => `<option value="${esc(l)}">${esc(l)}</option>`).join('');

  /* CALIB */
  document.getElementById("calib_filter_party").innerHTML =
    '<option value="">All</option>' +
    calibParties.map(p => `<option value="${esc(p)}">${esc(p)}</option>`).join('');

  document.getElementById("calib_filter_lot").innerHTML =
    '<option value="">All</option>' +
    calibLots.map(l => `<option value="${esc(l)}">${esc(l)}</option>`).join('');
}
/* ---------------------------------------------------------
   RENDER AJMZ TABLE
--------------------------------------------------------- */
function renderAJMZ(){
  const search = document.getElementById("globalSearch").value.toLowerCase();
  const party = document.getElementById("ajmz_filter_party").value;
  const lot = document.getElementById("ajmz_filter_lot").value;
  const dateFrom = document.getElementById("ajmz_filter_date_from").value;
  const dateTo = document.getElementById("ajmz_filter_date_to").value;

  let filtered = AJMZ_PARENTS.filter(p => {
    if (party && p.party !== party) return false;
    if (lot && p.lotName !== lot) return false;
    if (dateFrom && p.date < dateFrom) return false;
    if (dateTo && p.date > dateTo) return false;
    if (search) {
      const txt = JSON.stringify(p).toLowerCase();
      if (!txt.includes(search)) return false;
    }
    return true;
  });

  const tbody = document.getElementById("tbody_ajmz");
  tbody.innerHTML = "";

  let totalCTS = 0, totalPCS = 0, totalAmt = 0;
  let soldCTS = 0, soldPCS = 0, soldAmt = 0;
  let balCTS = 0, balPCS = 0, balAmt = 0;

  filtered.forEach(parent => {
    const sells = AJMZ_SELLS.filter(s => s.parentKey === parent.key);

    const soldC = sells.reduce((sum, s) => sum + s.cts, 0);
    const soldP = sells.reduce((sum, s) => sum + s.pcs, 0);
    const soldA = sells.reduce((sum, s) => sum + s.amount, 0);

    const origCTS = parent.cts;
    const origPCS = parent.pcs;

    const totalC = origCTS + soldC;
    const totalP = origPCS + soldP;
    const totalA = parent.amount + soldA;

    const balC = origCTS;
    const balP = origPCS;
    const balA = parent.amount;

    const avgSellPrice = soldC > 0 ? soldA / soldC : 0;

    totalCTS += totalC;
    totalPCS += totalP;
    totalAmt += totalA;

    soldCTS += soldC;
    soldPCS += soldP;
    soldAmt += soldA;

    balCTS += balC;
    balPCS += balP;
    balAmt += balA;

    const row = `
      <tr>
